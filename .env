# ======================================================================================================
#  Settings read automatically by `docker compose`.  Edit, save, run `docker compose up -d` again.
# ======================================================================================================

# Which optional stacks to start together with the always-on core (eureka, gateway, services, redis, UI).
#   elk      -> Elasticsearch + Logstash + Kibana        (~2.2 GB RAM)   lesson 1
#   metrics  -> Prometheus + Grafana                     (~0.4 GB RAM)   lessons 2-3
# Low on memory?  Use  COMPOSE_PROFILES=metrics   or leave it EMPTY, and enable the rest later.
COMPOSE_PROFILES=elk,metrics

# Network interface the published ports bind to.
#   127.0.0.1 = only this computer (safe default; the UI can pause/kill containers!)
#   0.0.0.0   = reachable from other devices in the classroom network
BIND_ADDR=127.0.0.1

# Host ports (left side of the port mapping). Change one if it is already used on your computer:
#   "Bind for 127.0.0.1:XXXX failed: port is already allocated"  ->  pick another number here.
UI_PORT=8800
GATEWAY_PORT=8880
EUREKA_PORT=8761
KIBANA_PORT=5601
GRAFANA_PORT=3030
PROMETHEUS_PORT=9099
ES_PORT=9200
REDIS_PORT=6380
# The three product-service instances, order-service and both BFFs are also published on 8081-8086 (see docker-compose.yml).

# Eureka self-preservation switch (lesson 5). Flip to false, then:  docker compose up -d eureka-server
EUREKA_SELF_PRESERVATION=true
# Seconds without a heartbeat before Eureka evicts an instance.
#   6 = fast classroom demo.   90 = Eureka's real default (needed to witness self-preservation, lesson 5).
# After changing:  docker compose up -d
EUREKA_LEASE_EXPIRATION=6
# Fraction of expected heartbeats that must arrive, otherwise self-preservation starts.
EUREKA_RENEWAL_THRESHOLD=0.85
