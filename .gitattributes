# Shell scripts and configs mounted into Linux containers MUST keep LF line endings,
# even when the repo is cloned on Windows (otherwise "bad interpreter: ^M").
*.sh   text eol=lf
*.conf text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.py   text eol=lf
*.java text eol=lf
*.xml  text eol=lf
Dockerfile text eol=lf
